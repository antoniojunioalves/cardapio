# Copie para .env e ajuste. O .env NUNCA vai para o repositório.
#
#   cp .env.example .env
#
# Os valores abaixo são de desenvolvimento local. Nenhum segredo real deve
# ser commitado aqui — em produção eles vêm do gerenciador de segredos do
# ambiente, nunca de arquivo versionado.

# ─────────────────────────────────────────────────────────────
# PostgreSQL (docker compose)
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cardapio
POSTGRES_PORT=5432

# Duas roles, com poderes diferentes de propósito. Nenhuma tem SUPERUSER ou
# BYPASSRLS — qualquer um dos dois faria o PostgreSQL ignorar todas as policies
# de isolamento entre tenants em silêncio. Veja docker/postgres/init/.
#
#   migrator — dono das tabelas, roda migrations, tem DDL
#   app      — somente SELECT/INSERT/UPDATE/DELETE; sem DDL, não consegue
#              desligar o Row-Level Security
MIGRATOR_DB_USER=cardapio_migrator
MIGRATOR_DB_PASSWORD=cardapio_migrator
APP_DB_USER=cardapio_app
APP_DB_PASSWORD=cardapio_app

# Conexão da API em execução. Usa a role sem DDL, jamais o superusuário.
# Obrigatória: a API não sobe sem ela. Um valor padrão apontaria em silêncio
# para o banco errado, o que é pior do que falhar na inicialização.
DATABASE_URL=postgresql://cardapio_app:cardapio_app@localhost:5432/cardapio

# Conexão usada SOMENTE pelo comando de migrations. Nunca pela API servindo
# requisições — é justamente essa separação que impede que uma injeção de SQL
# alcance DDL.
MIGRATION_DATABASE_URL=postgresql://cardapio_migrator:cardapio_migrator@localhost:5432/cardapio

# Banco usado pela suíte de testes. Separado do de desenvolvimento para que os
# testes possam criar e apagar tabelas à vontade.
TEST_DATABASE_URL=postgresql://cardapio_app:cardapio_app@localhost:5432/cardapio_test
TEST_MIGRATION_DATABASE_URL=postgresql://cardapio_migrator:cardapio_migrator@localhost:5432/cardapio_test

DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=info
# Origem autorizada no CORS.
WEB_ORIGIN=http://localhost:5173

# Limite global de requisições. Login, identificação por telefone e envio de
# pedido têm limites próprios, mais estritos, definidos nas rotas.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Ligue só atrás de um proxy reverso que reescreve o X-Forwarded-For. Sem proxy,
# ligado permite a qualquer cliente escolher o próprio IP e escapar dos limites.
TRUST_PROXY=false

# Tamanho máximo de um corpo JSON, em bytes.
JSON_BODY_LIMIT_BYTES=65536

# ─────────────────────────────────────────────────────────────
# Autenticação
# ─────────────────────────────────────────────────────────────
# Obrigatório, com no mínimo 32 caracteres. O valor abaixo é de
# desenvolvimento e NÃO deve ir para produção — lá ele vem do gerenciador de
# segredos do ambiente. Gere o seu com:
#
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# É um segredo só porque o refresh token não é assinado: ele é um valor
# aleatório opaco, verificado contra o banco.
JWT_SECRET=desenvolvimento-apenas-troque-em-producao-0000000000

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────
# Web
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3333

# ─────────────────────────────────────────────────────────────
# Armazenamento de imagens
# ─────────────────────────────────────────────────────────────
# Só `local` existe no MVP. Um provider S3 entra trocando este valor.
STORAGE_DRIVER=local
# Relativo ao diretório da API (apps/api). Está no .gitignore.
STORAGE_LOCAL_PATH=./uploads
# Endereço pelo qual o navegador busca as imagens.
STORAGE_PUBLIC_URL=http://localhost:3333/uploads
# Teto por arquivo, em bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# ─────────────────────────────────────────────────────────────
# E-mail
# ─────────────────────────────────────────────────────────────
# Em desenvolvimento, os e-mails vão para o Mailpit do docker compose (sobe
# junto com `pnpm db:up`) e ficam numa caixa em http://localhost:8025 — nada
# sai da máquina. Em produção, o SMTP do provedor escolhido no deploy.
EMAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# true só para TLS desde a conexão (porta 465); com false, o STARTTLS é
# negociado se o servidor oferecer.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remetente. Vazio, vale o nome do produto (packages/config) com
# nao-responda@localhost. Em produção, um endereço do domínio com SPF e DKIM:
#   EMAIL_FROM="Nome do produto <nao-responda@seu-dominio.com.br>"
EMAIL_FROM=
# Quem recebe o aviso de cada estabelecimento novo. Vazio, o aviso não é enviado.
PLATFORM_NOTIFY_EMAIL=
