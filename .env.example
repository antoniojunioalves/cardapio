# Copie para .env e ajuste. O .env NUNCA vai para o repositório.
#
#   cp .env.example .env
#
# Os valores abaixo são de desenvolvimento local. Nenhum segredo real deve
# ser commitado aqui — em produção eles vêm do gerenciador de segredos do
# ambiente, nunca de arquivo versionado.

# ─────────────────────────────────────────────────────────────
# PostgreSQL (docker compose)
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cardapio
POSTGRES_PORT=5432

# Role da aplicação — criada sem SUPERUSER e sem BYPASSRLS, para que o
# Row-Level Security realmente se aplique. Veja docker/postgres/init/.
APP_DB_USER=cardapio_app
APP_DB_PASSWORD=cardapio_app

# Usado a partir da Fase 2 (Drizzle + migrations). A aplicação conecta com a
# role restrita acima, jamais com o superusuário.
DATABASE_URL=postgresql://cardapio_app:cardapio_app@localhost:5432/cardapio

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=info
# Origem autorizada no CORS.
WEB_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Web
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3333

# ─────────────────────────────────────────────────────────────
# Ainda não utilizados — declarados aqui para referência
# ─────────────────────────────────────────────────────────────
# Fase 4 — autenticação administrativa
# JWT_SECRET=
# JWT_REFRESH_SECRET=
#
# Fase 6 — armazenamento de imagens
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./uploads
